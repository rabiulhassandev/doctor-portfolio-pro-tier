APP_NAME="Dr. Nafis Ahmed Chowdhury"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=single_doctor_pro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Clinic operations  (see config/booking.php)
# ---------------------------------------------------------------------------

# The timezone the chamber actually works in. Timestamps are always STORED in
# UTC; this is only what patients and staff see. Do not change APP timezone.
CLINIC_TIMEZONE=Asia/Dhaka

# How far ahead patients may book, and the shortest notice accepted.
BOOKING_HORIZON_DAYS=30
BOOKING_MIN_NOTICE_MINUTES=120
BOOKING_CANCELLATION_CUTOFF_HOURS=12

# What a new booking starts as: "pending" (doctor confirms by hand) or
# "confirmed" (slot is guaranteed immediately). A paid booking always confirms.
BOOKING_DEFAULT_STATUS=pending

# ---------------------------------------------------------------------------
# Payments  (see config/booking.php)
# ---------------------------------------------------------------------------

PAYMENTS_ENABLED=true

# Leave false so an abandoned payment still leaves the clinic an appointment
# they can ring the patient about.
PAYMENTS_REQUIRED=false

PAYMENT_GATEWAY=sslcommerz
PAYMENT_CURRENCY=BDT
PAYMENT_HOLD_MINUTES=15
PAYMENT_ALLOW_PAY_AT_CLINIC=true

# SSLCommerz sandbox credentials.
# Register a free sandbox store at https://developer.sslcommerz.com/ and paste
# the store ID and password here. Set SSLCOMMERZ_SANDBOX=false to go live.
# Leave these blank and the online payment option is simply hidden — the site
# still takes bookings with "pay at the chamber".
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ---------------------------------------------------------------------------
# SMS / WhatsApp  (INTEGRATION POINT — no paid gateway ships with the template)
# ---------------------------------------------------------------------------

# "null" writes the message to storage/logs/laravel.log so you can see exactly
# what would have been sent without an account anywhere. Switch to "http" and
# fill in the three values below to use most bulk-SMS REST APIs, or write your
# own class implementing App\Contracts\SmsSender.
SMS_ENABLED=false
SMS_DRIVER=null
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=
